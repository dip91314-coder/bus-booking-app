# Server Configuration
PORT=5000
NODE_ENV=development

# Database & Storage
MONGO_URI=mongodb://127.0.0.1:27017/busbooking

# Redis Caching & Lock Gate
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true

# Authentication & Security
JWT_SECRET=your_jwt_access_secret_key_minimum_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Business Rules
LOCK_MINUTES=8

# Payment Gateway (Optional / Mock default in development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Seed & Admin Initialization (Random in production if not set)
ADMIN_SEED_PASSWORD=admin123
